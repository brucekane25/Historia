# Copy to .env.local for local development.
# In production (Render) set these in the service Environment tab.

# MongoDB connection string. Required by the /api/events/* route handlers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/test?retryWrites=true&w=majority

# Database name. The events collection currently lives in `test`.
MONGODB_DB=test

NODE_ENV=development
